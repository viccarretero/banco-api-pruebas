{
  "info": {
    "name": "Banco API - Pruebas funcionales",
    "description": "Pruebas de API con Newman para Banco API (.NET 8).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('La API responde ok', () => pm.expect(pm.response.json().estado).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02 - Listar cuentas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve una lista con cuentas', () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data).to.be.an('array');",
              "  pm.expect(data.length).to.be.at.least(2);",
              "});",
              "pm.test('Responde en menos de 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cuentas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cuentas"
          ]
        }
      }
    },
    {
      "name": "03 - Obtener cuenta existente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Datos de la cuenta 1', () => {",
              "  const c = pm.response.json();",
              "  pm.expect(c.id).to.eql(1);",
              "  pm.expect(c.titular).to.eql('Ana Torres');",
              "  pm.expect(c.saldo).to.eql(1500);",
              "});",
              "pm.test('Cumple el esquema', () => {",
              "  const esquema = { type: 'object', required: ['id', 'titular', 'saldo'],",
              "    properties: { id: { type: 'integer' }, titular: { type: 'string' }, saldo: { type: 'number' } } };",
              "  pm.response.to.have.jsonSchema(esquema);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cuentas/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cuentas",
            "1"
          ]
        }
      }
    },
    {
      "name": "04 - Cuenta inexistente devuelve 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Mensaje de error', () => pm.expect(pm.response.json().error).to.include('no existe'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cuentas/999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cuentas",
            "999"
          ]
        }
      }
    },
    {
      "name": "05 - Crear cuenta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Devuelve la cabecera Location', () => pm.response.to.have.header('Location'));",
              "const c = pm.response.json();",
              "pm.test('Cuenta creada con los datos enviados', () => {",
              "  pm.expect(c.titular).to.eql('Maria Quispe');",
              "  pm.expect(c.saldo).to.eql(100);",
              "});",
              "pm.collectionVariables.set('cuentaId', c.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cuentas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cuentas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"titular\":\"Maria Quispe\",\"saldoInicial\":100}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
